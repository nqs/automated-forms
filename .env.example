# Model used by Stagehand for act/observe/extract. Format: provider/model.
STAGEHAND_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# Optional: run the browser on Browserbase instead of a local Chrome.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=

# Optional: path to a Chrome/Chromium binary for local runs.
# CHROME_PATH=/usr/bin/google-chrome
